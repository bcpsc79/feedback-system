# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon PostgreSQL connection string
DATABASE_URL=

# better-auth secret — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# ── Category routing ──────────────────────────────────────────────────────────
# Which staff email receives each category of report (for notification routing).
# Leave blank to disable email notifications for that category.
CATEGORY_BULLYING_HARASSMENT_EMAIL=admin@school.edu
CATEGORY_SAFETY_HAZARD_EMAIL=admin@school.edu
CATEGORY_MENTAL_HEALTH_CONCERN_EMAIL=counselor@school.edu
CATEGORY_ABUSE_EXPLOITATION_EMAIL=safeguarding@school.edu
CATEGORY_ACADEMIC_DISHONESTY_EMAIL=principal@school.edu
CATEGORY_POLICY_COMPLAINT_EMAIL=admin@school.edu
CATEGORY_OTHER_EMAIL=admin@school.edu

# ── Urgency resources ─────────────────────────────────────────────────────────
# Shown on the confirmation screen for Abuse/Exploitation and Mental Health reports.
URGENCY_PHONE=988
URGENCY_COUNSELOR_CONTACT=counselor@school.edu
